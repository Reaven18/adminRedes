!configuración de Switch de Core piso 4 Edificio Central Campus 2
enable
conf t
!Parametros básicos
hostname C2ECP4_01_SWC
ip domain-name equipo4.com
banner motd #Acceso restringido a personal autorizado#
enable secret class
service password-encryption
username admin secret cisco
line con 0
password cisco
login
line vty 0 4
transport input ssh
login local
!Configuración de ssh
crypto key generate rsa
1024
!Configuración de puerto truncal
interface range gi1/0/1 - 12
switchport mode trunk
!
ip ssh version 2
!Configuracion de Spanning-Tree
spanning-tree mode rapid-pvst
!Switch raiz de toda la topologia
spanning-tree vlan 1-4094 root primary
!
!Configuración de VTP
vtp version 2
vtp mode server
vtp domain CAMPUS_2
vtp password cisco123
!
!Configuración de VLANs
vlan 71
name Administrativos
vlan 72
name Soporte_TI
vlan 73
name Estudiantes
vlan 74
name Profesores
vlan 75
name Camaras
vlan 77
name Admin_Infra_TI
vlan 81
name Laboratorios_DyA
vlan 82
name Camaras_DyA
vlan 83
name Jefatura_DyA
vlan 84
name Administrativos_DyA
vlan 91
name Salas_lectura_TT
vlan 92
name Camaras_TT
vlan 93
name Jefatura_TT
vlan 94
name Taller_TT_A
vlan 95
name Taller_TT_B
!Falta agrgar todas las VLANs
!Configuración de puerto truncal
interface range gi1/0/1 - 12
switchport mode trunk
switchport trunk allowed vlan all
!Configuración de enrutamiento
exit
ip routing
interface vlan 71
ip address 172.31.3.190 255.255.255.224
no shutdown
interface vlan 72
ip address 172.31.3.158 255.255.255.224
no shutdown
interface vlan 73
ip address 172.31.1.254 255.255.254.0
no shutdown
interface vlan 74
ip address 172.31.3.62 255.255.255.192
no shutdown
interface vlan 75
ip address 172.31.4.14 255.255.255.240
no shutdown
interface vlan 81
ip address 172.31.2.126 255.255.255.128
no shutdown
interface vlan 82
ip address 172.31.3.254 255.255.255.240
no shutdown
interface vlan 83
ip address 172.31.3.238 255.255.255.240
no shutdown
interface vlan 84
ip address 172.31.3.222 255.255.255.240
no shutdown
interface vlan 91
ip address 172.31.2.190 255.255.255.192
no shutdown
interface vlan 92
ip address 172.31.3.206 255.255.255.240
no shutdown
interface vlan 93
ip address 172.31.4.22 255.255.255.248
no shutdown
interface vlan 94
ip address 172.31.3.126 255.255.255.224
no shutdown
interface vlan 95
ip address 172.31.3.94 255.255.255.224
no shutdown
interface vlan 77
ip address 172.31.2.254 255.255.255.192
no shutdown