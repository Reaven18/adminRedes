!configuración de Switch de Acceso piso 1 Edificio Central
enable
conf t
!Parametros básicos
hostname C2ECP1_01_SWA
ip domain-name equipo4.com
banner motd #Acceso restringido a personal autorizado#
enable secret class
service password-encryption
username admin secret cisco
line con 0
password cisco
login
line vty 0 4
transport input ssh
login local
!Configuración de ssh
crypto key generate rsa
1024
ip ssh version 2
!
!Configuracion de STP
spanning-tree mode rapid-pvst
!Configuracion de puertos de borde (hosts)
int range f0/1 - 24
spanning-tree portfast
spanning-tree bpduguard enable
exit
!
!Configuración de VTP
vtp version 2
vtp mode client
vtp domain CAMPUS_2
vtp password cisco123
!
!Asignación de puertos a VLANs
interface range fa0/1 - 2
switchport mode access
switchport access vlan 71
interface range fa0/3 - 4
switchport mode access
switchport access vlan 72
interface range fa0/5 - 8
switchport mode access
switchport access vlan 73
interface range fa0/9 - 12
switchport mode access
switchport access vlan 74
interface fa0/13
switchport mode access
switchport access vlan 75
interface range fa0/23 - 24
switchport mode access
switchport access vlan 77
!
!Configuracion de EtherChannel
interface range gi0/1 - 2
switchport mode trunk
switchport nonegotiate
switchport trunk allowed vlan 71,72,73,74,75,77
!
!Configuración de interface de administración
interface vlan 99
ip address 172.31.2.194 255.255.255.192
no shutdown
!Configuración de gateway predeterminado
ip default-gateway 172.31.2.254

