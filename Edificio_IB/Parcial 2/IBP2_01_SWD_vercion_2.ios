!configuración de Switch de Distribuición piso 2 Edificio de Biomedica
enable
conf t
!Parametros básicos
hostname IBP2_01_SWD
ip domain-name equipo4.com
banner motd #Acceso restringido a personal autorizado#
enable secret class
service password-encryption
username admin secret cisco
line con 0
password cisco
login
line vty 0 4
transport input ssh
login local
!Configuración de ssh
crypto key generate rsa
yes
1024
ip ssh version 2
!
!Configuración de VTP
vtp version 2
vtp mode server
vtp domain BIOMEDICA
vtp password cisco123
!
!Configuración de VLANs
vlan 31
name Laboratorios_IB
vlan 32
name Camaras_IB
vlan 33
name Jefatura_IB
vlan 34
name Administrativos_IB
vlan 99
name Admin_Infra_TI
!Configuración de puerto truncal
interface range gi1/0/1 - 8
switchport mode trunk
switchport nonegotiate
switchport trunk allowed vlan all
!Configuración de interface de administración
no shutdown
interface vlan 99
ip address 172.26.36.142 255.255.255.128
no shutdown
!Configuración de gateway predeterminado
ip default-gateway 172.26.36.254