!configuración de Switch de Acceso piso 2 Edificio de Administración
enable
conf t
!Parametros básicos
hostname AEP2_01_SWA
ip domain-name equipo4.com
banner motd #Acceso restringido a personal autorizado#
enable secret class
service password-encryption
username admin secret cisco
line con 0
password cisco
login
line vty 0 4
transport input ssh
login local
!Configuración de ssh
crypto key generate rsa
1024
ip ssh version 2
!
!
!Configuracion de STP
spanning-tree mode rapid-pvst
!Configuracion de puertos de borde (hosts)
int range f0/1 - 24
spanning-tree portfast
spanning-tree bpduguard enable
exit
!
!Configuración de VTP
vtp version 2
vtp mode client
vtp domain ADMINISTRACION
vtp password cisco123
!
!Asignación de puertos a VLANs
interface range fa0/1 - 4
switchport mode access
switchport access vlan 12
interface range fa0/4 - 8
switchport mode access
switchport access vlan 13
interface range fa0/8 - 12
switchport mode access
switchport access vlan 14
interface range fa0/23 - 24
switchport mode access
switchport access vlan 99
!Configuración de puerto truncal
interface range gi0/1 - 2
switchport mode trunk
switchport nonegotiate
switchport trunk allowed vlan 12,13,14,99
!Configuración de interface de administración
interface vlan 99
ip address 172.26.36.135 255.255.255.128
no shutdown
!Configuración de gateway predeterminado
ip default-gateway 172.26.36.254