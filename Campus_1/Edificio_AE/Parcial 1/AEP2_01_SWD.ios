!configuración de Switch de Distribuición piso 2 Edificio de Administración
enable
conf t
!Parametros básicos
hostname AEP2_01_SWD
ip domain-name equipo4.com
banner motd #Acceso restringido a personal autorizado#
enable secret class
service password-encryption
username admin secret cisco
line con 0
password cisco
login
line vty 0 4
transport input ssh
login local
!Configuración de ssh
crypto key generate rsa
1024
ip ssh version 2
!
!Configuración de VLANs
vlan 11
name Laboratorios_AE
vlan 12
name Camaras_AE
vlan 13
name Jefatura_AE
vlan 14
name Administrativos_AE
vlan 99
name Admin_Infra_TI
!Configuración de puerto truncal
interface range gi1/0/1 - 5
switchport mode trunk
switchport trunk allowed vlan all
!Configuración de interface de administración
no shutdown
interface vlan 99
ip address 172.26.36.136 255.255.255.128
no shutdown
!Configuración de gateway predeterminado
ip default-gateway 172.26.36.254